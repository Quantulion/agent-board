#!/bin/sh
# Wrapper around the agent-board CLI: finds the repository relative to itself, checks Python, runs the module.
set -e

# installed from a fixed commit (scripts/install.py): independent of the repository working tree
installed="${AGENT_BOARD_HOME:-$HOME/.agent-board}/bin/agent-board"
if [ -x "$installed" ] && [ -z "${AGENT_BOARD_FROM_REPO:-}" ]; then
    exec "$installed" "$@"
fi

script="$0"
while [ -h "$script" ]; do
    dir=$(cd -P "$(dirname "$script")" && pwd)
    link=$(readlink "$script")
    case "$link" in
        /*) script="$link" ;;
        *) script="$dir/$link" ;;
    esac
done
here=$(cd -P "$(dirname "$script")" && pwd)
repo=$(cd -P "$here/../../.." 2>/dev/null && pwd) || repo=""
if [ ! -d "$repo/board/agent_board" ]; then
    echo "agent-board: board code not found next to the skill; install via scripts/install-codex.sh (symlink) or the" \
        "Claude Code plugin: the skill dir must stay inside the agent-board repository" >&2
    exit 127
fi

python="${AGENT_BOARD_PYTHON:-python3}"
if ! command -v "$python" >/dev/null 2>&1; then
    echo "agent-board: $python not found; install Python 3.9+ or set AGENT_BOARD_PYTHON" >&2
    exit 127
fi
if ! "$python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    echo "agent-board: Python 3.9+ is required ($python is older); set AGENT_BOARD_PYTHON to a newer interpreter" >&2
    exit 127
fi

exec env PYTHONPATH="$repo/board${PYTHONPATH:+:$PYTHONPATH}" "$python" -m agent_board "$@"
